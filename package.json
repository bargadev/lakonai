{
  "name": "lakonai",
  "version": "0.10.0",
  "description": "lakonai — save AI context tokens. Filters & compresses CLI output (git, ls, grep, find, test runners, lint/build, docker/kubectl/aws) before it reaches Claude Code, Codex, Cursor, Windsurf, Cline or Gemini — and learns to filter new commands automatically the more you use it.",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "windsurf",
    "cline",
    "gemini",
    "llm",
    "tokens",
    "token-savings",
    "context-window",
    "ai-coding",
    "agent",
    "cli",
    "output-filter",
    "test-runner",
    "eslint",
    "pytest"
  ],
  "license": "MIT",
  "author": "bargadev",
  "homepage": "https://github.com/bargadev/lakonai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bargadev/lakonai.git"
  },
  "bugs": {
    "url": "https://github.com/bargadev/lakonai/issues"
  },
  "type": "commonjs",
  "main": "src/filters/index.js",
  "bin": {
    "lakonai": "bin/lakonai.js"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:coverage:check": "jest --coverage",
    "bench": "node scripts/bench.js",
    "bench:output": "node scripts/bench-output.js",
    "bench:measure": "node scripts/bench-measure.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
